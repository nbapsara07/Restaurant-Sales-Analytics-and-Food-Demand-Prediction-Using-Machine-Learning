# 3. Scale features using training data only
train_x <- train_data[, features]
test_x <- test_data[, features]
feature_means <- sapply(train_x, mean)
feature_sds <- sapply(train_x, sd)
feature_sds[feature_sds == 0] <- 1
train_x_scaled <- scale(
train_x, center = feature_means, scale = feature_sds
)
test_x_scaled <- scale(
test_x, center = feature_means, scale = feature_sds
)
# 4. Train/predict using KNN regression
# K = 5 nearest neighbors
set.seed(123)
knn_result <- FNN::knn.reg(
train = train_x_scaled,
test = test_x_scaled,
y = train_data$Daily_Quantity,
k = 5
)
predictions <- pmax(0, as.numeric(knn_result$pred))
actual <- test_data$Daily_Quantity
# 5. Evaluation metrics
MAE <- mean(abs(actual - predictions))
RMSE <- sqrt(mean((actual - predictions)^2))
R2 <- 1 - sum((actual - predictions)^2) /
sum((actual - mean(actual))^2)
cat("\nKNN REGRESSION RESULTS\n")
cat("----------------------\n")
cat("Split date:", as.character(split_date), "\n")
cat("Training rows:", nrow(train_data), "\n")
cat("Testing rows:", nrow(test_data), "\n")
cat("K neighbors: 5\n")
cat("MAE:", round(MAE, 3), "\n")
cat("RMSE:", round(RMSE, 3), "\n")
cat("R-squared:", round(R2, 3), "\n")
# Save predictions
results <- data.frame(
Date = test_data$Date,
Food_Name = test_data$Food_Name,
Actual = actual,
Predicted = predictions
)
results$Error <- results$Actual - results$Predicted
write.csv(
results,
"shared_outputs/KNN_Predictions.csv",
row.names = FALSE
)
# GRAPH 1: Actual vs Predicted Demand
p1 <- ggplot(results, aes(Actual, Predicted)) +
geom_point(alpha = 0.25, color = "steelblue") +
geom_abline(
intercept = 0, slope = 1,
color = "red", linetype = "dashed"
) +
labs(
title = "KNN: Actual vs Predicted Demand",
x = "Actual Daily Quantity",
y = "Predicted Daily Quantity"
) +
theme_minimal()
print(p1)
ggsave(
"shared_outputs/KNN_Actual_vs_Predicted.png",
plot = p1, width = 8, height = 5
)
# GRAPH 2: Prediction Error Distribution
p2 <- ggplot(results, aes(x = Error)) +
geom_histogram(bins = 30, fill = "orange", color = "white") +
geom_vline(
xintercept = 0, color = "red", linetype = "dashed"
) +
labs(
title = "KNN: Prediction Error Distribution",
x = "Error (Actual - Predicted)",
y = "Number of Predictions"
) +
theme_minimal()
print(p2)
ggsave(
"shared_outputs/KNN_Error_Distribution.png",
plot = p2, width = 8, height = 5
)
# GRAPH 3: Actual vs Predicted for a sample of test rows
set.seed(123)
sample_size <- min(200, nrow(results))
sample_rows <- sample(seq_len(nrow(results)), sample_size)
sample_results <- results[sample_rows, ]
sample_results <- sample_results[
order(sample_results$Date, sample_results$Food_Name),
]
sample_long <- pivot_longer(
sample_results,
cols = c(Actual, Predicted),
names_to = "Type",
values_to = "Quantity"
)
p3 <- ggplot(
sample_long,
aes(x = Date, y = Quantity, color = Type)
) +
geom_line(alpha = 0.7) +
labs(
title = "KNN: Actual vs Predicted Demand (Sample)",
x = "Date",
y = "Daily Quantity",
color = "Series"
) +
theme_minimal()
print(p3)
ggsave(
"shared_outputs/KNN_Demand_Comparison.png",
plot = p3, width = 8, height = 5
)
cat("\nAll 3 graphs and predictions saved successfully!\n")
# RESTAURANTIQ - MODEL COMPARISON
library(ggplot2)
library(dplyr)
# 1. Set output folder
output_folder <- "shared_outputs"
# 2. List the five models and their prediction files
files <- c(
"Linear Regression" = "Linear_Predictions.csv",
"Decision Tree" = "DecisionTree_Predictions.csv",
"Random Forest" = "RandomForest_Predictions.csv",
"Gradient Boosting" = "GradientBoosting_Predictions.csv",
"KNN Regression" = "KNN_Predictions.csv"
)
# 3. Calculate evaluation metrics
comparison <- data.frame()
for (model_name in names(files)) {
file_path <- file.path(output_folder, files[model_name])
if (!file.exists(file_path)) {
warning(paste("File not found:", file_path))
next
}
predictions <- read.csv(file_path)
if (!all(c("Actual", "Predicted") %in% names(predictions))) {
warning(paste("Actual or Predicted column missing:", file_path))
next
}
predictions <- predictions %>%
filter(is.finite(Actual), is.finite(Predicted))
actual <- predictions$Actual
predicted <- predictions$Predicted
mae <- mean(abs(actual - predicted))
rmse <- sqrt(mean((actual - predicted)^2))
r_squared <- if (length(actual) > 1 &&
sum((actual - mean(actual))^2) > 0) {
1 - sum((actual - predicted)^2) /
sum((actual - mean(actual))^2)
} else {
NA_real_
}
comparison <- rbind(
comparison,
data.frame(
Model = model_name,
MAE = mae,
RMSE = rmse,
R2 = r_squared
)
)
}
# 4. Display results
print(comparison)
# 5. Save comparison table
write.csv(
comparison,
file.path(output_folder, "Model_Comparison.csv"),
row.names = FALSE
)
# 6. Graph 1: MAE comparison
p1 <- ggplot(comparison,
aes(x = reorder(Model, MAE), y = MAE)) +
geom_col(fill = "steelblue") +
coord_flip() +
labs(
title = "Model Comparison - MAE",
x = "Model",
y = "Mean Absolute Error"
) +
theme_minimal()
ggsave(file.path(output_folder, "Comparison_MAE.png"),
p1, width = 8, height = 5)
# 7. Graph 2: RMSE comparison
p2 <- ggplot(comparison,
aes(x = reorder(Model, RMSE), y = RMSE)) +
geom_col(fill = "darkorange") +
coord_flip() +
labs(
title = "Model Comparison - RMSE",
x = "Model",
y = "Root Mean Squared Error"
) +
theme_minimal()
ggsave(file.path(output_folder, "Comparison_RMSE.png"),
p2, width = 8, height = 5)
# 8. Graph 3: R-squared comparison
p3 <- ggplot(comparison,
aes(x = reorder(Model, R2), y = R2)) +
geom_col(fill = "seagreen") +
coord_flip() +
labs(
title = "Model Comparison - R-squared",
x = "Model",
y = "R-squared"
) +
theme_minimal()
ggsave(file.path(output_folder, "Comparison_R2.png"),
p3, width = 8, height = 5)
cat("Model comparison completed!\n")
